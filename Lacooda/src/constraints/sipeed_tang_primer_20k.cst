// IO_LOC "ddram_reset_n" B9;
// IO_PORT "ddram_reset_n" IO_TYPE=SSTL15;
// ---------------------------------------------------------------------------
// Dock user LEDs LED0..LED5, active low (low = lit).
// led4 (A13) and led5 (C13) double as the configuration READY/DONE pins, so
// they only place while the dual-purpose configuration above is enabled.
// ---------------------------------------------------------------------------
IO_LOC "led0" L16;
IO_PORT "led0" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led1" L14;
IO_PORT "led1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led2" N14;
IO_PORT "led2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led3" N16;
IO_PORT "led3" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led4" A13;
IO_PORT "led4" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led5" C13;
IO_PORT "led5" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---------------------------------------------------------------------------
// Dock user keys S0/S1, active low (low = pressed).
// btn_n0 T10 is dual-purpose (SSPI SI/D2) and needs the configuration above.
// btn_n1 T3 sits in bank 4, which is 1.5 V on this board, hence LVCMOS15.
// ---------------------------------------------------------------------------
IO_LOC "btn_n0" T10;
IO_PORT "btn_n0" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "btn_n1" T3;
IO_PORT "btn_n1" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// ---------------------------------------------------------------------------
// OPTIONAL: further Dock keys S2..S4. Not ports of the current fpga_top.
// NOTE: T2 is bank 4 (1.5 V), but D7 and C7 are bank 6, whose device default is
// 1.8 V (LVCMOS18) - the Sipeed Litex template constrained them as LVCMOS15.
// Confirm bank 6's VCCIO against the Dock schematic before enabling.
// ---------------------------------------------------------------------------
// IO_LOC "btn_n2" T2;
// IO_PORT "btn_n2" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// IO_LOC "btn_n3" D7;
// IO_PORT "btn_n3" IO_TYPE=LVCMOS18 PULL_MODE=UP BANK_VCCIO=1.8;
// IO_LOC "btn_n4" C7;
// IO_PORT "btn_n4" IO_TYPE=LVCMOS18 PULL_MODE=UP BANK_VCCIO=1.8;