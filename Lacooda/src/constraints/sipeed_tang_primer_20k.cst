// ============================================================
// LACOODA physical constraints - Sipeed Tang Primer 20K
//
// Ports must match the synthesizable FPGA top (src/rtl/soc/fpga_top.sv):
//   clk27, btn_n0, btn_n1 -> clock / buttons
//   led0..led5            -> observation LEDs
//
// BANK / VOLTAGE facts below come from this project's own Place & Route
// report (impl/pnr/lacooda.rpt.txt, Gowin V1.9.11.03, GW2A-18C):
//   clk27  H11      bank 0  3.3 V  GCLKT_0
//   btn_n0 T10      bank 3  3.3 V  dual-purpose SSPI SI/D2
//   led4   A13      bank 3  3.3 V  dual-purpose READY
//   led5   C13      bank 3  3.3 V  dual-purpose DONE
//   led0..3 L16 L14 N14 N16  bank 1  3.3 V
//   btn_n1 T3       bank 4  1.5 V
//
// The dual-purpose pins are a PROJECT setting, not a .cst constraint
// (Project > Configuration > Dual-Purpose Pin; impl/pnr/device.cfg holds
//  SSPI/READY/DONE regular_io = true and RECONFIG_N regular_io = false).
//
// Constraint lines that name ports absent from the top module make Place &
// Route fail with CT1135, so optional board interfaces stay commented out.
// ============================================================

// ---------------------------------------------------------------------------
// 27 MHz onboard oscillator (bank 0, 3.3 V, dedicated global clock GCLKT_0)
// ---------------------------------------------------------------------------
IO_LOC "clk27" H11;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// ---------------------------------------------------------------------------
// OPTIONAL: USB-UART bridge (onboard BL702). Not ports of the current fpga_top.
// T13/M11 are bank 2, whose DEVICE default is 1.8 V, yet the working Sipeed UART
// example drives them as LVCMOS33 with an explicit BANK_VCCIO=3.3 - i.e. the Dock
// feeds bank 2 at 3.3 V. Keep the explicit attribute; do not rely on the default.
// ---------------------------------------------------------------------------
// IO_LOC "serial_rx" T13;
// IO_PORT "serial_rx" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// IO_LOC "serial_tx" M11;
// IO_PORT "serial_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---------------------------------------------------------------------------
// OPTIONAL: onboard 1 Gbit DDR3 SDRAM (SSTL15). Not in the current fpga_top.
//
// NAMING: the Gowin DDR3 Memory Interface IP names these ports ddr_addr,
// ddr_bank, ddr_ras, ddr_cas, ddr_we, ddr_cs, ddr_ck, ddr_cke, ddr_odt,
// ddr_reset_n, ddr_dm, ddr_dq, ddr_dqs - NOT the ddram_* names of the Sipeed
// Litex template used below. Rename when the IP is instantiated.
//
// Every pin needs an explicit BANK_VCCIO=1.5: the DDR3 pins span banks 4, 5 and
// 6, whose device defaults are 1.5 / 1.8 / 1.8 V respectively. The DQ/DQS groups
// must stay together, and VREF=INTERNAL belongs on the DQ pins only.
// Pin data: Sipeed example, cross-checked against this device's PnR report.
// ---------------------------------------------------------------------------
// IO_LOC "ddram_a[0]" F7;
// IO_PORT "ddram_a[0]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[1]" A4;
// IO_PORT "ddram_a[1]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[2]" D6;
// IO_PORT "ddram_a[2]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[3]" F8;
// IO_PORT "ddram_a[3]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[4]" C4;
// IO_PORT "ddram_a[4]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[5]" E6;
// IO_PORT "ddram_a[5]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[6]" B1;
// IO_PORT "ddram_a[6]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[7]" D8;
// IO_PORT "ddram_a[7]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[8]" A5;
// IO_PORT "ddram_a[8]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[9]" F9;
// IO_PORT "ddram_a[9]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[10]" K3;
// IO_PORT "ddram_a[10]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[11]" B7;
// IO_PORT "ddram_a[11]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[12]" A3;
// IO_PORT "ddram_a[12]" IO_TYPE=SSTL15;
// IO_LOC "ddram_a[13]" C8;
// IO_PORT "ddram_a[13]" IO_TYPE=SSTL15;
// IO_LOC "ddram_ba[0]" H4;
// IO_PORT "ddram_ba[0]" IO_TYPE=SSTL15;
// IO_LOC "ddram_ba[1]" D3;
// IO_PORT "ddram_ba[1]" IO_TYPE=SSTL15;
