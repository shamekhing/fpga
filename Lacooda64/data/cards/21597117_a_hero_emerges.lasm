; Generated by tools/split_effects.py from data/effects.lasm.
; Audited locally: A1.#39 identifies the attacker; #79 is its controller.
; Selected card must have IS.MONSTER (#62), CAN_SPECIAL_SUMMON (#223) and a free slot.
; Native SUMMON layout: position=8, face_up=4, defense_position=9, controller=79.
; These corrections are local to this card file, not the combined generator output.
; Each .program retains its original PCs, registers and labels.

; A Hero Emerges: effect 1 (TRIGGER, optional=0)
.program 21597117_1
PC Instruction Meaning
    0 COMPARE F0, CONTROL.EVENT_KIND, #157, EQUAL                                  ; ATTACK_DECLARED.
    1 JUMPIF F0, 49, FALSE                                                        
    2 ATTRIBUTE A2, A1, #39                                                        ; Event SUBJECT is the attacking monster.
    3 LOAD A3, A2                                                                 
    4 ATTRIBUTE A2, A3, #79                                                        ; Attacker controller must be the opponent.
    5 LOAD V2, A2                                                                 
    6 COMPARE F0, V2, V1, EQUAL                                                   
    7 JUMPIF F0, 49, FALSE                                                        
    8 SELECT A2, [0:2:0]                                                          
    9 SELECT A3, [0:0]                                                            
   10 COMPARE F0, V0, #0, EQUAL                                                   
   11 JUMPIF F0, 14                                                               
   12 SELECT A2, [1:2:0]                                                          
   13 SELECT A3, [1:0]                                                            
   14 ENUMERATE V2, A2                                                            
   15 LENGTH V3, V2                                                               
   16 COMPARE F0, V3, #0, GREATER                                                 
   17 JUMPIF F0, 49, FALSE                                                        
   18 RANDOM RANDOM_CARD, V4, NONE, V3                                             ; Random selection from the controller's hand.
   19 AT A5, V2, V4                                                               
   20 ATTRIBUTE A2, A5, #62                                                        ; IS.MONSTER must hold independently of capability.
   21 LOAD V3, A2                                                                 
   22 COMPARE F0, V3, #1, EQUAL                                                   
   23 JUMPIF F0, 42, FALSE                                                        
   24 ATTRIBUTE A2, A5, #223                                                       ; CAN.CAN_SPECIAL_SUMMON.
   25 LOAD V3, A2                                                                 
   26 COMPARE F0, V3, #1, EQUAL                                                   
   27 JUMPIF F0, 42, FALSE                                                        
   28 ATTRIBUTE A2, A3, #7                                                         ; FREE_MONSTER_SLOT is an address or immediate zero.
   29 LOAD V3, A2                                                                 
   30 COMPARE F0, V3, #0, EQUAL                                                   
   31 JUMPIF F0, 42                                                               
   32 SET A4, V3                                                                  
   33 CHOOSE V3, #2, V0                                                            ; Choose position before the SUMMONED event.
   34 COMPARE F0, V3, #0, EQUAL                                                   
   35 JUMPIF F0, 38                                                               
   36 SUMMON SPECIAL, FACE_UP_DEFENSE, A4, A5                                     
   37 JUMP 39                                                                     
   38 SUMMON SPECIAL, FACE_UP_ATTACK, A4, A5                                      
   39 ATTRIBUTE A2, A5, #3                                                        
   40 STORE A2, #1                                                                 ; Keep numeric zone property in step with movement.
   41 JUMP 49                                                                     
   42 ATTRIBUTE A2, A5, #14                                                        ; Failed eligibility sends to the owner's Graveyard.
   43 LOAD V3, A2                                                                 
   44 SELECT A4, [0:3:0]                                                          
   45 COMPARE F0, V3, #0, EQUAL                                                   
   46 JUMPIF F0, 48                                                               
   47 SELECT A4, [1:3:0]                                                          
   48 MOVE SEND, A4, A5, #1 | cause=3                                             
   49 HALT                                                                        
.end
