   27 AT A3, V2, V5                                                               
   28 ALU V5, V5, #1, ADD                                                         
   29 COMPARE F0, A3, A0, EQUAL                                                   
   30 JUMPIF F0, 25                                                               
   31 ATTRIBUTE A2, A3, #3                                                        
   32 LOAD V6, A2                                                                 
   33 COMPARE F0, V6, #1, EQUAL                                                   
   34 JUMPIF F0, 39                                                               
   35 COMPARE F0, V6, #4, EQUAL                                                   
   36 JUMPIF F0, 39                                                               
   37 COMPARE F0, V6, #6, EQUAL                                                   
   38 JUMPIF F0, 25, FALSE                                                        
   39 ATTRIBUTE A2, A3, #4                                                        
