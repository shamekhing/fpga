; Generated by tools/split_effects.py from data/effects.lasm.
; Audited locally: coin declaration precedes RNG consumption; only opposing attackers qualify.
; A1.#166=ATTACKER. Self #246 stores last maintenance turn plus one; initialize it to #0.
; Maintenance checks the controller's Standby Phase and destroys this card if payment is impossible.
; These fixes are local to this card file, not the combined generator output.
; Each .program retains its original PCs, registers and labels.

; Fairy Box: effect 1 (TRIGGER, optional=0)
.program 21598948_1
PC Instruction Meaning
    0 COMPARE F0, CONTROL.EVENT_KIND, #157, EQUAL                                 
    1 JUMPIF F0, 30, FALSE                                                        
    2 ATTRIBUTE A2, A0, #3                                                        
    3 LOAD V2, A2                                                                 
    4 COMPARE F0, V2, #4, EQUAL                                                   
    5 JUMPIF F0, 30, FALSE                                                        
    6 ATTRIBUTE A2, A0, #4                                                        
    7 LOAD V2, A2                                                                 
    8 COMPARE F0, V2, #1, EQUAL                                                   
    9 JUMPIF F0, 30, FALSE                                                        
   10 ATTRIBUTE A2, A1, #166                                                       ; ATTACKER.
   11 LOAD A3, A2                                                                 
   12 ATTRIBUTE A2, A3, #79                                                       
   13 LOAD V2, A2                                                                 
   14 COMPARE F0, V2, V1, EQUAL                                                   
   15 JUMPIF F0, 30, FALSE                                                        
   16 CHOOSE V2, #2, V0                                                            ; Commit HEADS=0 or TAILS=1 before consuming RNG.
   17 RANDOM COIN, V3, NONE, #2                                                   
   18 COMPARE F0, V2, V3, EQUAL                                                   
   19 JUMPIF F0, 30, FALSE                                                        
   20 ATTRIBUTE A2, A3, #10                                                       
   21 MODIFY V4, A2, #0, SET                                                      
   22 SUBSCRIBE V5, 24, #136                                                      
   23 JUMP 30                                                                     
   24 ATTRIBUTE A2, [0], #1                                                       
   25 LOAD V2, A2                                                                 
   26 COMPARE F0, V2, #3, EQUAL                                                   
   27 JUMPIF F0, 30, FALSE                                                        
   28 CANCEL V5                                                                   
   29 UNMODIFY V4                                                                 
   30 HALT                                                                        
.end

; Fairy Box: effect 2 (MAINTENANCE, optional=0)
.program 21598948_2
PC Instruction Meaning
    0 COMPARE F0, CONTROL.EVENT_KIND, #131, EQUAL                                 
    1 JUMPIF F0, 47, FALSE                                                        
    2 ATTRIBUTE A2, A0, #3                                                        
    3 LOAD V2, A2                                                                 
    4 COMPARE F0, V2, #4, EQUAL                                                   
    5 JUMPIF F0, 47, FALSE                                                        
    6 ATTRIBUTE A2, A0, #4                                                        
    7 LOAD V2, A2                                                                 
    8 COMPARE F0, V2, #1, EQUAL                                                   
    9 JUMPIF F0, 47, FALSE                                                        
   10 ATTRIBUTE A2, [0], #1                                                       
   11 LOAD V2, A2                                                                 
   12 COMPARE F0, V2, #4, EQUAL                                                   
   13 JUMPIF F0, 47, FALSE                                                        
   14 ATTRIBUTE A2, [0], #2                                                       
   15 LOAD V2, A2                                                                 
   16 COMPARE F0, V2, V0, EQUAL                                                   
   17 JUMPIF F0, 47, FALSE                                                        
   18 ATTRIBUTE A2, [0], #122                                                     
   19 LOAD V3, A2                                                                 
   20 ALU V3, V3, #1, ADD                                                         
   21 ATTRIBUTE A3, A0, #246                                                       ; Last maintenance turn plus one; initially zero.
   22 LOAD V2, A3                                                                 
   23 COMPARE F0, V2, V3, EQUAL                                                   
   24 JUMPIF F0, 47                                                               
   25 SELECT A2, [0:0]                                                            
   26 COMPARE F0, V0, #0, EQUAL                                                   
   27 JUMPIF F0, 29                                                               
   28 SELECT A2, [1:0]                                                            
   29 ATTRIBUTE A4, A2, #36                                                       
   30 LOAD V2, A4                                                                 
   31 COMPARE F0, V2, #500, GREATER_EQUAL                                         
   32 JUMPIF F0, 39, FALSE                                                         ; Inability to pay destroys, rather than faulting.
   33 CHOOSE V2, #2, V0                                                           
   34 COMPARE F0, V2, #0, EQUAL                                                   
   35 JUMPIF F0, 39, FALSE                                                        
   36 PAY_LP A4, #500 | flags=4 cause=3                                           
   37 STORE A3, V3                                                                
   38 JUMP 47                                                                     
   39 STORE A3, V3                                                                
   40 ATTRIBUTE A2, A0, #14                                                       
   41 LOAD V2, A2                                                                 
   42 SELECT A4, [0:3:0]                                                          
   43 COMPARE F0, V2, #0, EQUAL                                                   
   44 JUMPIF F0, 46                                                               
   45 SELECT A4, [1:3:0]                                                          
   46 MOVE DESTROY, A4, A0, #1 | cause=3                                          
   47 HALT                                                                        
.end
