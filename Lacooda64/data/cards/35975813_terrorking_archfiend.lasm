; Audited against data/effects.txt TEXT, lines 404-444; corrected locally.
; Restriction 44 prohibits Normal/Flip Summon when no other face-up Archfiend
; monster is controlled. Modifier 45 belongs only to this instance.
; Self.246 records the paid Standby turn + 1 (initialize to zero). Pay once,
; using native mandatory PAY_LP; insufficient payment returns its runtime fault.
; Targeting event 132: SUBJECT=39 is this card, SOURCE=38 is the opponent card
; with an unresolved runtime chain link. Native NEGATE changes that link.
; Battle event 128: SOURCE=38 is this card, DESTROYED=42 is the victim address.
; Victim effect negation 47 lasts for that instance; reset it for a new instance.

; Terrorking Archfiend: effect 1 (RULE, optional=0)
.program 35975813_1
PC Instruction Meaning
    0 ATTRIBUTE A2, A0, #45                                                       
    1 LOAD V2, A2                                                                 
    2 COMPARE F0, V2, #0, EQUAL                                                   
    3 JUMPIF F0, 6                                                                
    4 UNMODIFY V2                                                                 
    5 STORE A2, #0                                                                
    6 SELECT A3, [0:1:0]                                                          
    7 COMPARE F0, V0, #0, EQUAL                                                   
    8 JUMPIF F0, 10                                                               
    9 SELECT A3, [1:1:0]                                                          
   10 ENUMERATE V2, A3                                                            
   11 LENGTH V3, V2                                                               
   12 SET V4, #0                                                                  
   13 COMPARE F0, V4, V3, GREATER_EQUAL                                           
   14 JUMPIF F0, 28                                                               
   15 AT A3, V2, V4                                                               
   16 ALU V4, V4, #1, ADD                                                         
   17 COMPARE F0, A3, A0, EQUAL                                                   
   18 JUMPIF F0, 13                                                               
   19 ATTRIBUTE A2, A3, #4                                                        
   20 LOAD V5, A2                                                                 
   21 COMPARE F0, V5, #1, EQUAL                                                   
   22 JUMPIF F0, 13, FALSE                                                        
   23 ATTRIBUTE A2, A3, #43                                                       
   24 LOAD V5, A2                                                                 
   25 COMPARE F0, V5, #1, EQUAL                                                   
   26 JUMPIF F0, 32                                                               
   27 JUMP 13                                                                     
   28 ATTRIBUTE A2, A0, #44                                                       
   29 MODIFY V2, A2, #1, SET                                                      
   30 ATTRIBUTE A2, A0, #45                                                       
   31 STORE A2, V2                                                                
   32 HALT                                                                        
.end

