    1 JUMPIF F0, 28, FALSE                                                        
    2 ATTRIBUTE A2, A0, #3                                                        
    3 LOAD V2, A2                                                                 
    4 COMPARE F0, V2, #1, EQUAL                                                   
    5 JUMPIF F0, 28, FALSE                                                        
    6 ATTRIBUTE A2, A0, #4                                                        
    7 LOAD V2, A2                                                                 
    8 COMPARE F0, V2, #1, EQUAL                                                   
    9 JUMPIF F0, 28, FALSE                                                        
   10 LOAD V2, [1]                                                                
   11 COMPARE F0, V2, #4, EQUAL                                                   
   12 JUMPIF F0, 28, FALSE                                                        
   13 LOAD V2, [2]                                                                
   14 COMPARE F0, V2, V0, EQUAL                                                   
   15 JUMPIF F0, 28, FALSE                                                        
   16 LOAD V3, [122]                                                              
   17 ALU V3, V3, #1, ADD                                                         
   18 ATTRIBUTE A2, A0, #246                                                      
   19 LOAD V2, A2                                                                 
   20 COMPARE F0, V2, V3, EQUAL                                                   
   21 JUMPIF F0, 28                                                               
   22 SELECT A3, [0:36]                                                           
   23 COMPARE F0, V0, #0, EQUAL                                                   
   24 JUMPIF F0, 26                                                               
