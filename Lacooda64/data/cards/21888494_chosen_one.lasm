   18 ATTRIBUTE A2, A4, #41                                                       
   19 LOAD V7, A2                                                                 
   20 ATTRIBUTE A2, A4, #147                                                      
   21 LOAD V8, A2                                                                 
   22 ALU V7, V7, V8, ADD                                                         
   23 COMPARE F0, V7, #0, GREATER                                                 
   24 JUMPIF F0, 28, FALSE                                                        
   25 APPEND V4, A4                                                               
   26 JUMP 28                                                                     
   27 APPEND V3, A4                                                               
   28 ALU V6, V6, #1, ADD                                                         
   29 JUMP 11                                                                     
   30 LENGTH V5, V3                                                               
   31 COMPARE F0, V5, #1, GREATER_EQUAL                                           
   32 JUMPIF F0, 95, FALSE                                                        
   33 LENGTH V5, V4                                                               
   34 COMPARE F0, V5, #2, GREATER_EQUAL                                           
   35 JUMPIF F0, 95, FALSE                                                        
   36 CHOOSE A5, V3, V0                                                            ; Choose one monster.
   37 CHOOSE A6, V4, V0                                                            ; Choose first non-monster.
   38 ENUMERATE V7, NONE                                                          
   39 SET V6, #0                                                                  
   40 COMPARE F0, V6, V5, GREATER_EQUAL                                           
   41 JUMPIF F0, 48                                                               
   42 AT A4, V4, V6                                                               
   43 COMPARE F0, A4, A6, EQUAL                                                   
   44 JUMPIF F0, 46                                                               
   45 APPEND V7, A4                                                               
   46 ALU V6, V6, #1, ADD                                                         
   47 JUMP 40                                                                     
   48 CHOOSE A7, V7, V0                                                            ; Choose a distinct second non-monster.
   49 ENUMERATE V8, NONE                                                          
   50 APPEND V8, A5                                                               
   51 APPEND V8, A6                                                               
   52 APPEND V8, A7                                                               
   53 EVENT TARGET, A5, A3, NONE                                                  
   54 EVENT TARGET, A6, A3, NONE                                                  
   55 EVENT TARGET, A7, A3, NONE                                                  
   56 RANDOM RANDOM_CARD, V9, NONE, #3                                             ; Uniformly choose from all three selected cards.
   57 SET F10, #0                                                                  ; No card has yet been summoned.
   58 COMPARE F0, V9, #0, EQUAL                                                   
   59 JUMPIF F0, 78, FALSE                                                        
   60 ATTRIBUTE A2, A5, #223                                                       ; Check summon eligibility, not merely card type.
   61 LOAD V7, A2                                                                 
   62 COMPARE F0, V7, #1, EQUAL                                                   
   63 JUMPIF F0, 78, FALSE                                                        
   64 ATTRIBUTE A2, A3, #7                                                        
   65 LOAD V7, A2                                                                 
   66 COMPARE F0, V7, #0, EQUAL                                                   
   67 JUMPIF F0, 78                                                               
   68 SET A4, V7                                                                  
   69 CHOOSE V7, #2, V0                                                           
   70 COMPARE F0, V7, #0, EQUAL                                                   
   71 JUMPIF F0, 74                                                               
   72 SUMMON SPECIAL, FACE_UP_DEFENSE, A4, A5                                     
   73 JUMP 75                                                                     
